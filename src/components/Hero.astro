---
import { profile } from '../data/profile';
import { tx, ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = ui[locale];
---

<header class="hero wrap" id="about">
  <img
    class="portrait"
    src="/images/portrait.jpg"
    alt={locale === 'zh' ? `${profile.nameZh}的照片` : `Photo of ${profile.name}`}
    width="360"
    height="450"
  />
  <h1 class="hero-name">
    <span class="name-en">{profile.name}</span>
    <span class="name-zh">{profile.nameZh}</span>
  </h1>
  <div class="hero-body">
    <p class="bio">{tx(locale, profile.bio)}</p>
    <ul class="links">
      <li><a href={profile.githubUrl}>{strings.github}</a></li>
      <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
    </ul>
  </div>
</header>
