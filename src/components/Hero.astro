---
import { cveStats, cves } from '../data/cves';
import { profile } from '../data/profile';
import { tx, ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = ui[locale];
const stats = cveStats(cves);
---

<header class="hero wrap" id="about">
  <div class="mark" aria-hidden="true">XZ</div>
  <div>
    <h1>
      <span class="name-en">{profile.name}</span>
      <span class="name-zh">{profile.nameZh}</span>
    </h1>
    <p class="role">
      <strong>{tx(locale, profile.role)}</strong>
      <span> · {tx(locale, profile.org)}</span>
    </p>
    <p class="bio">{tx(locale, profile.bio)}</p>
    <ul class="links">
      <li><a href={profile.githubUrl}>{strings.github}</a></li>
      <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
    </ul>
  </div>
</header>
<div class="wrap vendor-strip">
  <p class="kicker">{strings.statVendors}</p>
  <ul class="vendor-list">
    {stats.vendors.map((vendor) => <li>{vendor}</li>)}
  </ul>
</div>
