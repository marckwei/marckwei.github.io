---
import { timeline } from '../data/timeline';
import { tx, ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = ui[locale];
---

<section class="wrap" id="timeline">
  <div class="section-head">
    <div>
      <p class="kicker">{strings.timelineKicker}</p>
      <h2>{strings.timelineTitle}</h2>
    </div>
  </div>
  <ol class="timeline">
    {
      timeline.map((item) => (
        <li class="tl-item">
          <div class="tl-body">
            <p class="period">{tx(locale, item.period)}</p>
            <h3>{tx(locale, item.title)}</h3>
            <p class="org">{tx(locale, item.org)}</p>
            <p>{tx(locale, item.body)}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>
