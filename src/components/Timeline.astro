---
import { timeline } from '../data/timeline';
import { tx, ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = ui[locale];
---

<section class="wrap" id="timeline">
  <div class="section-head">
    <div>
      <p class="kicker">{strings.timelineKicker}</p>
      <h2>{strings.timelineTitle}</h2>
    </div>
  </div>
  <ol class="timeline">
    {
      timeline.map((item) => (
        <li class="tl-item">
          <div class="tl-body">
            <p class="period">{tx(locale, item.period)}</p>
            <h3>{tx(locale, item.title)}</h3>
            <p class="org">{tx(locale, item.org)}</p>
            {item.body && <p>{tx(locale, item.body)}</p>}
            {item.tracks && (
              <div class="tracks">
                {item.tracks.map((track) => (
                  <div class="track">
                    <div class="track-head">
                      <h4>{tx(locale, track.title)}</h4>
                      <span class="period">{tx(locale, track.period)}</span>
                    </div>
                    <ul>
                      {track.points.map((point) => (
                        <li>{tx(locale, point)}</li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</section>
