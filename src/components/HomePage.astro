---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from './Hero.astro';
import CodeBuddyTeaser from './CodeBuddyTeaser.astro';
import CveList from './CveList.astro';
import PublicationList from './PublicationList.astro';
import Timeline from './Timeline.astro';
import { cveStats, cves, highlightCves } from '../data/cves';
import { profile } from '../data/profile';
import { cvePath, tx, ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = ui[locale];
const highlights = highlightCves(cves);
const vendorLine = strings.cveVendorLine.replace('{vendors}', cveStats(cves).vendors.join(' · '));
---

<BaseLayout locale={locale} kind="home" title={strings.homeTitle} description={tx(locale, profile.bio)}>
  <Hero locale={locale} />
  <Timeline locale={locale} />
  <CodeBuddyTeaser locale={locale} />
  <section class="wrap" id="cves">
    <div class="section-head">
      <div>
        <p class="kicker">{strings.cveKicker}</p>
        <h2>{strings.cveTitle}</h2>
      </div>
      <a href={cvePath(locale)}>
        {strings.cveAll} ({cves.length})
      </a>
    </div>
    <p class="vendor-line">{vendorLine}</p>
    <CveList locale={locale} items={highlights} variant="cards" />
  </section>
  <PublicationList locale={locale} />
</BaseLayout>
