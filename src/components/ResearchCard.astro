---
import type { ResearchArea } from '../data/research';
import { tx, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  area: ResearchArea;
}

const { locale, area } = Astro.props;
---

<article class="card">
  <h3>{tx(locale, area.title)}</h3>
  <p>{tx(locale, area.body)}</p>
</article>
